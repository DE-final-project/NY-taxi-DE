{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "peak_heatmap",
  "position": {
    "x": 20,
    "y": 75,
    "z": 0,
    "height": 400,
    "width": 1240,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold dim_date"
                    }
                  },
                  "Property": "Weekday"
                }
              },
              "queryRef": "gold dim_date.Weekday",
              "nativeQueryRef": "Weekday"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold fact_trips"
                    }
                  },
                  "Property": "Trips"
                }
              },
              "queryRef": "gold fact_trips.Trips",
              "nativeQueryRef": "Trips"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold fact_trips"
                    }
                  },
                  "Property": "pickup_hour"
                }
              },
              "queryRef": "gold fact_trips.pickup_hour",
              "nativeQueryRef": "pickup_hour"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Q1: When is demand highest? Trips by weekday x pickup hour'"
                }
              }
            }
          }
        }
      ]
    }
  }
}