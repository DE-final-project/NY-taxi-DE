table 'gold fact_trips'
	lineageTag: f9ae9bf3-e911-469a-872f-2e7779b56329

	/// Number of clean trips (one row per trip in gold.fact_trips).
	measure Trips = COUNTROWS('gold fact_trips')
		formatString: #,##0
		displayFolder: Key Measures
		lineageTag: ecca6317-09bd-416b-9dc3-d640a7350791

	/// Total amount charged to riders (fare + surcharges + tips + tolls).
	measure Revenue = SUM('gold fact_trips'[total_amount])
		formatString: $#,##0
		displayFolder: Key Measures
		lineageTag: f42eb114-0827-4e6d-85ab-227c8da4fb45

	/// Average metered fare per trip.
	measure 'Avg Fare' = AVERAGE('gold fact_trips'[fare_amount])
		formatString: $#,##0.00
		displayFolder: Key Measures
		lineageTag: 67e749a4-bf22-4c37-bfd4-ba03d01b021d

	/// Average total amount per trip.
	measure 'Revenue per Trip' = DIVIDE([Revenue], [Trips])
		formatString: $#,##0.00
		displayFolder: Key Measures
		lineageTag: 48f9138e-77a9-40f1-a012-25fe8ca172fa

	/// Average trip distance in miles.
	measure 'Avg Distance (mi)' = AVERAGE('gold fact_trips'[trip_distance])
		formatString: #,##0.00
		displayFolder: Key Measures
		lineageTag: 0f0f8c96-16e9-4567-b116-953456b07898

	/// Average trip duration in minutes.
	measure 'Avg Duration (min)' = AVERAGE('gold fact_trips'[trip_duration_min])
		formatString: #,##0.0
		displayFolder: Key Measures
		lineageTag: 53cba1eb-7cb6-4e33-bba5-acf2d431a242

	/// Tips as a share of the fare. Cash tips are not recorded by the meter, so cash trips show ~0%.
	measure 'Tip %' = DIVIDE(SUM('gold fact_trips'[tip_amount]), SUM('gold fact_trips'[fare_amount]))
		formatString: 0.0%
		displayFolder: Key Measures
		lineageTag: ef9bf9b1-5372-4f6c-9d4f-3ce313f6ff58

	/// Share of trips within the current filter, across payment types.
	measure 'Trips Share' = DIVIDE([Trips], CALCULATE([Trips], REMOVEFILTERS('gold dim_payment_type')))
		formatString: 0.0%
		displayFolder: Key Measures
		lineageTag: 3cc70100-7055-4230-ac58-e51ed0ed2869

	/// Tip % on credit-card trips only (the only payment type where tips are recorded).
	measure 'Card Tip %' = ﻿CALCULATE([Tip %], 'gold dim_payment_type'[payment_type] = "Credit card")
		formatString: 0.0%
		displayFolder: Key Measures
		lineageTag: e1b11477-4bb9-4fe5-b727-dcdd56c12740

