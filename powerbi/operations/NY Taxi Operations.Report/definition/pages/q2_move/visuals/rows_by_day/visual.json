{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "rows_by_day",
  "position": {
    "x": 20,
    "y": 195,
    "z": 6,
    "height": 270,
    "width": 600,
    "tabOrder": 6
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold pipeline_metrics"
                    }
                  },
                  "Property": "load_date"
                }
              },
              "queryRef": "gold pipeline_metrics.load_date",
              "nativeQueryRef": "load_date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold pipeline_metrics"
                    }
                  },
                  "Property": "Rows Delivered"
                }
              },
              "queryRef": "gold pipeline_metrics.Rows Delivered",
              "nativeQueryRef": "Rows Delivered"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "gold pipeline_metrics"
                    }
                  },
                  "Property": "Rows Rejected"
                }
              },
              "queryRef": "gold pipeline_metrics.Rows Rejected",
              "nativeQueryRef": "Rows Rejected"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Q2: Rows delivered vs rejected per load day'"
                }
              }
            }
          }
        }
      ]
    },
    "objects": {
      "categoryAxis": [
        {
          "properties": {
            "axisType": {
              "expr": {
                "Literal": {
                  "Value": "'Categorical'"
                }
              }
            }
          }
        }
      ]
    }
  }
}