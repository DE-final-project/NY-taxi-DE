table 'public dag_run'
	lineageTag: dd9c070c-b2a9-4c48-b5e0-7ac32e9dd9db

	/// Pipeline runs (DAG runs) in Airflow.
	measure Runs = COUNTROWS('public dag_run')
		formatString: #,##0
		displayFolder: Q1 Runs
		lineageTag: 1702b51d-e879-4f20-9de3-86b5b23f0ed6

	/// Runs that finished with state success.
	measure 'Successful Runs' = CALCULATE([Runs], 'public dag_run'[state] = "success")
		formatString: #,##0
		displayFolder: Q1 Runs
		lineageTag: 76233f7f-eeb8-4b39-87e9-0b8c19b9ac40

	/// Runs that finished with state failed (a task failed after all retries).
	measure 'Failed Runs' = CALCULATE([Runs], 'public dag_run'[state] = "failed")
		formatString: #,##0
		displayFolder: Q1 Runs
		lineageTag: 5c2686ec-c50e-493b-af81-97b7ae3f6f3c

	/// Successful runs / all runs.
	measure 'Run Success Rate' = DIVIDE([Successful Runs], [Runs])
		formatString: 0.0%
		displayFolder: Q1 Runs
		lineageTag: 85ff9b10-0c10-4785-9572-c8d1a66293c7

	/// Average wall-clock time of finished runs, in minutes.
	measure 'Avg Run Duration (min)' = AVERAGEX(FILTER('public dag_run', NOT ISBLANK('public dag_run'[end_date])), DATEDIFF('public dag_run'[start_date], 'public dag_run'[end_date], SECOND)) / 60
		formatString: #,##0.0
		displayFolder: Q1 Runs
		lineageTag: d477e097-3db0-474b-ab34-8b56036d21d6

