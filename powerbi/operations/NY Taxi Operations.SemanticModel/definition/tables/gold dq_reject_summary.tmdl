table 'gold dq_reject_summary'
	lineageTag: 1f8b3f32-478c-43cd-bb6b-47da94bf6d0d

	/// Quarantined rows (by reason, from dq_reject_summary).
	measure 'Quarantined Rows' = SUM('gold dq_reject_summary'[rows_rejected])
		formatString: #,##0
		displayFolder: Q3 Data Quality
		lineageTag: 3775370d-48cd-4744-8d20-3c0bb06ec0b0

	/// Rows whose issue is fixed by the pipeline (duplicates removed).
	measure 'Resolved Rows' = CALCULATE([Quarantined Rows], 'gold dq_rules'[status] = "Resolved")
		formatString: #,##0
		displayFolder: Q3 Data Quality
		lineageTag: ba67e073-f722-49cc-b0ea-743de61dea4f

	/// Rows with source-data errors that cannot be fixed - kept in quarantine for audit.
	measure 'Isolated Rows' = CALCULATE([Quarantined Rows], 'gold dq_rules'[status] = "Isolated")
		formatString: #,##0
		displayFolder: Q3 Data Quality
		lineageTag: 41b32bec-526b-4092-b73a-82f59f75dee9

