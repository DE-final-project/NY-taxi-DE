table 'gold pipeline_metrics'
	lineageTag: 336922b8-7367-40cb-a1ed-95ea66699a84

	/// Rows copied from the lake into SQL Server raw.
	measure 'Rows Loaded' = SUM('gold pipeline_metrics'[rows_loaded])
		formatString: #,##0
		displayFolder: Q2 Data Movement
		lineageTag: dd4bddd3-84b7-4c07-b3ec-80596fee8f77

	/// Raw rows that went to quarantine instead of silver.
	measure 'Rows Rejected' = SUM('gold pipeline_metrics'[rows_rejected])
		formatString: #,##0
		displayFolder: Q2 Data Movement
		lineageTag: df15f318-da7f-4ad2-9092-5c27aabd1a66

	/// Raw rows that reached silver/gold (loaded - rejected).
	measure 'Rows Delivered' = [Rows Loaded] - [Rows Rejected]
		formatString: #,##0
		displayFolder: Q2 Data Movement
		lineageTag: 4e49af24-81cf-4a41-90ab-61d80ec80cd1

	/// Share of loaded rows that reached gold.
	measure 'Delivery Rate' = DIVIDE([Rows Delivered], [Rows Loaded])
		formatString: 0.0%
		displayFolder: Q2 Data Movement
		lineageTag: c1fd8fc9-87c6-485c-8adb-3dd5396c1565

	/// Share of loaded rows rejected by data-quality rules.
	measure 'Error Rate' = DIVIDE([Rows Rejected], [Rows Loaded])
		formatString: 0.00%
		displayFolder: Q2 Data Movement
		lineageTag: 475afdbd-c161-4185-86b7-c790eb0fb3ef

	/// Extra copies of a trip removed by the dedup.
	measure 'Duplicates Removed' = SUM('gold pipeline_metrics'[rows_duplicate])
		formatString: #,##0
		displayFolder: Q2 Data Movement
		lineageTag: 4a31422a-61f6-4321-a9ea-0f221a3d794b

	/// Lake Parquet files loaded.
	measure 'Files Loaded' = SUM('gold pipeline_metrics'[files_loaded])
		formatString: #,##0
		displayFolder: Q2 Data Movement
		lineageTag: dfcbce32-e452-4507-b320-683ded1f873d

	/// Seconds spent loading files into raw.
	measure 'Load Time (s)' = SUM('gold pipeline_metrics'[load_seconds])
		formatString: #,##0
		displayFolder: Q2 Data Movement
		lineageTag: a2bfc22d-be8a-46ac-9e61-0b575f7dc04f

	/// Rows loaded per second.
	measure 'Throughput (rows/s)' = DIVIDE([Rows Loaded], [Load Time (s)])
		formatString: #,##0
		displayFolder: Q2 Data Movement
		lineageTag: 2b7f881d-0695-4667-bbed-cfcabc52a838

	column load_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: bf1af0ce-4ed3-41aa-bdea-159ccc5e86b1
