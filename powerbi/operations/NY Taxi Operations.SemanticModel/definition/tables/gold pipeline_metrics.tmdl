		summarizeBy: sum
		sourceColumn: error_rate_pct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'gold pipeline_metrics' = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost,1436", "ny_taxi_dwh"),
				    gold_pipeline_metrics = Source{[Schema="gold",Item="pipeline_metrics"]}[Data]
				in
